# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is gitignored: never commit it.

# --- Firebase web app config (public, safe for the browser) ---
# OPTIONAL: the project's config is already in lib/firebase/client.ts. Set these only to point at another project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SECRET, server only) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key (downloads a JSON).
# Option A (simplest): put the JSON in the project root (it's gitignored) and set its file name here.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Option B: copy three fields from that JSON. Keep the quotes around the private key; \n stays as is.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# --- Claude API for AI review of tasks (SECRET, server only) ---
# https://console.anthropic.com/settings/keys -> Create Key
ANTHROPIC_API_KEY=
